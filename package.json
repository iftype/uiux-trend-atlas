{
  "name": "uiux-trend-atlas",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "test": "npm run build",
    "lint": "node node_modules/eslint/bin/eslint.js . --ignore-pattern .next --ignore-pattern out",
    "research:update": "node scripts/update-foreign-sources.mjs && node scripts/update-open-source-stats.mjs",
    "test:robots": "node scripts/test-robots.mjs",
    "test:policy": "node scripts/test-generated-policy.mjs",
    "check": "npm run test:robots && npm run test:policy && npm run lint && npm run build"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
